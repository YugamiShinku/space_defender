[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 blink_color : source_color;
uniform float blink_intensity;



void fragment() {
// Input:5
	vec4 n_out5p0 = COLOR;
	float n_out5p4 = n_out5p0.a;


// ColorParameter:9
	vec4 n_out9p0 = blink_color;


// FloatParameter:7
	float n_out7p0 = blink_intensity;


// FloatOp:8
	float n_out8p0 = n_out5p4 * n_out7p0;


// Mix:4
	vec4 n_out4p0 = mix(n_out5p0, n_out9p0, vec4(n_out8p0));


// Output:0
	COLOR.rgb = vec3(n_out4p0.xyz);


}
"
