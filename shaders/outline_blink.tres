code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 outline_color : source_color;
uniform vec4 blink_color : source_color;
uniform float blink_intensity;
uniform float outline_thickness;



void fragment() {
	vec4 n_out41p0;
// Texture2D:41
	n_out41p0 = texture(TEXTURE, UV);
	float n_out41p4 = n_out41p0.a;


// ColorParameter:46
	vec4 n_out46p0 = outline_color;


	vec3 n_out45p0;
// If:45
	float n_in45p1 = 0.00000;
	float n_in45p2 = 0.00001;
	vec3 n_in45p5 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out41p4 - n_in45p1) < n_in45p2)
	{
		n_out45p0 = vec3(n_out46p0.xyz);
	}
	else if(n_out41p4 < n_in45p1)
	{
		n_out45p0 = n_in45p5;
	}
	else
	{
		n_out45p0 = vec3(n_out41p0.xyz);
	}


// Input:52
	vec4 n_out52p0 = COLOR;
	float n_out52p4 = n_out52p0.a;


// ColorParameter:49
	vec4 n_out49p0 = blink_color;


// FloatParameter:50
	float n_out50p0 = blink_intensity;


// FloatOp:47
	float n_out47p0 = n_out52p4 * n_out50p0;


// Mix:48
	vec4 n_out48p0 = mix(n_out52p0, n_out49p0, vec4(n_out47p0));


// Mix:53
	vec4 n_out53p0 = mix(vec4(n_out45p0, 0.0), n_out48p0, vec4(n_out41p4));


// Input:9
	vec2 n_out9p0 = UV;


// VectorCompose:4
	float n_in4p0 = 1.00000;
	float n_in4p1 = 0.00000;
	vec2 n_out4p0 = vec2(n_in4p0, n_in4p1);


// FloatParameter:5
	float n_out5p0 = outline_thickness;


// Input:6
	vec2 n_out6p0 = TEXTURE_PIXEL_SIZE;


// VectorOp:7
	vec2 n_out7p0 = vec2(n_out5p0) * n_out6p0;


// VectorOp:8
	vec2 n_out8p0 = n_out4p0 * n_out7p0;


// VectorOp:10
	vec2 n_out10p0 = n_out9p0 - n_out8p0;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(TEXTURE, n_out10p0);
	float n_out3p4 = n_out3p0.a;


// Input:34
	vec2 n_out34p0 = UV;


// VectorCompose:31
	float n_in31p0 = 0.00000;
	float n_in31p1 = 1.00000;
	vec2 n_out31p0 = vec2(n_in31p0, n_in31p1);


// VectorOp:30
	vec2 n_out30p0 = n_out31p0 * n_out7p0;


// VectorOp:35
	vec2 n_out35p0 = n_out34p0 - n_out30p0;


	vec4 n_out36p0;
// Texture2D:36
	n_out36p0 = texture(TEXTURE, n_out35p0);
	float n_out36p4 = n_out36p0.a;


// FloatOp:38
	float n_out38p0 = n_out3p4 + n_out36p4;


// Input:16
	vec2 n_out16p0 = UV;


// VectorCompose:13
	float n_in13p0 = -1.00000;
	float n_in13p1 = 0.00000;
	vec2 n_out13p0 = vec2(n_in13p0, n_in13p1);


// VectorOp:12
	vec2 n_out12p0 = n_out13p0 * n_out7p0;


// VectorOp:17
	vec2 n_out17p0 = n_out16p0 - n_out12p0;


	vec4 n_out18p0;
// Texture2D:18
	n_out18p0 = texture(TEXTURE, n_out17p0);
	float n_out18p4 = n_out18p0.a;


// FloatOp:39
	float n_out39p0 = n_out38p0 + n_out18p4;


// Input:25
	vec2 n_out25p0 = UV;


// VectorCompose:22
	float n_in22p0 = 0.00000;
	float n_in22p1 = -1.00000;
	vec2 n_out22p0 = vec2(n_in22p0, n_in22p1);


// VectorOp:21
	vec2 n_out21p0 = n_out22p0 * n_out7p0;


// VectorOp:26
	vec2 n_out26p0 = n_out25p0 - n_out21p0;


	vec4 n_out27p0;
// Texture2D:27
	n_out27p0 = texture(TEXTURE, n_out26p0);
	float n_out27p4 = n_out27p0.a;


// FloatOp:40
	float n_out40p0 = n_out39p0 + n_out27p4;


// FloatOp:43
	float n_out43p0 = n_out40p0 + n_out41p4;


// Output:0
	COLOR.rgb = vec3(n_out53p0.xyz);
	COLOR.a = n_out43p0;


}
