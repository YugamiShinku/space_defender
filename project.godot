;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Space Pirates"
run/main_scene="uid://bdf8lrfvpdl88"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://assets/icon.svg"

[display]

