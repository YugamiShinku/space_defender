;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Terminal Rogue"
run/main_scene="uid://bdf8lrfvpdl88"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="uid://di7blt54xgw4"

[audio]

buses/default_bus_layout=""

[autoload]

Vibration="*res://scripts/utils/vibration.gd"
AudioSources="*res://scripts/utils/audio_sources.gd"
SaveLoad="*res://scripts/save/save_load.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/AS2P/plugin.cfg", "res://addons/AsepriteWizard/plugin.cfg")

[global_group]

